# Giscus 댓글/리액션 설정
# https://giscus.app 에서 저장소를 입력하면 아래 값들을 발급받을 수 있다.
# 사전 준비: 대상 GitHub 저장소에 Discussions 활성화 + giscus 앱 설치.
# 이 값들은 공개되어도 무방한 값이므로 NEXT_PUBLIC_ 접두사를 사용한다.
# 실제 값은 .env.local 에 채운다. (.env.local 은 git 에 커밋되지 않음)

NEXT_PUBLIC_GISCUS_REPO=blcklamb/blcklamb-log
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
